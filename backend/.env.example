# --- Database -------------------------------------------------------------
# Docker Compose overrides this with PostgreSQL. SQLite is used when unset.
DATABASE_URL=postgresql+psycopg2://superport:superport@localhost:5432/superport
# DATABASE_URL=sqlite:///./superport.db

# --- Auth -----------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEMO_MODE=true            # enables the one-click demo login
SEED_DEMO_DATA=true       # seeds realistic demo shipments on first boot

# --- AI layer -------------------------------------------------------------
# demo = deterministic mock AI, no external calls
# live = use configured LLM provider (falls back to demo behaviour if missing)
AI_MODE=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# --- v2 intelligence (Gemini + SerpApi) --------------------------------------
# off = v1 behaviour | fixtures = sample web evidence, no keys | live = real APIs
INTELLIGENCE_MODE=off
GEMINI_API_KEY=
SERPAPI_API_KEY=
# Leave the model names empty to auto-detect what your key can use.
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=
SERPAPI_BUDGET_PER_SHIPMENT=12
GEMINI_BUDGET_PER_SHIPMENT=20
CACHE_TTL_HOURS=72
# Leave empty: fabricated demo values are disabled automatically in live mode.
ALLOW_SYNTHETIC_EXTRACTION=
COLLECT_FEEDBACK=true

# --- Milestones 3 and 4 -------------------------------------------------------
SERPAPI_DAILY_CAP=80            # hard cap on live searches per day across the whole app
RADAR_INTERVAL_MINUTES=0        # 0 = scan only when someone clicks "Scan now"; e.g. 360 = every 6 hours
RADAR_MAX_QUERIES=6             # searches per radar scan
RADAR_WINDOW=w                  # news recency: h hour, d day, w week, m month

# --- Milestone 5: accounts, email, production safety --------------------------
ENVIRONMENT=development         # production refuses to start with the default SECRET_KEY, DEMO_MODE=true or SEED_DEMO_DATA=true
APP_URL=http://localhost:3000   # used to build links in emails
RESEND_API_KEY=                 # resend.com. Leave empty in development: links are shown on screen instead
EMAIL_FROM=                     # for example: SuperPort <no-reply@yourdomain.com> (a domain verified in Resend)

# --- Milestone 6: tracking and Radar 2.0 ----------------------------------------
TRACKING_PROVIDER=sample        # sample = demo data (always labelled). none = hand-updated timeline. Real providers: add an adapter in app/tracking/providers.py

# --- Milestone 7: RAG, vector search, copilot ---------------------------------------
VECTOR_STORE=auto               # auto = pgvector when PostgreSQL has the extension, else a local store. local | pgvector to force
EMBEDDING_DIM=768               # changing it later means dropping the rag_vectors table
GEMINI_EMBEDDING_MODEL=         # leave empty to auto-detect from your key
COPILOT_MODEL_KIND=fast         # fast | pro: the Gemini tier that writes copilot answers
RAG_TOP_K=6
